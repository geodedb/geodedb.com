{{- $pages := where site.RegularPages "Kind" "!=" "taxonomy" -}}
{{- $index := slice -}}
{{- range $pages -}}
  {{- $content := .Plain | truncate 5000 "" -}}
  {{- $entry := dict
    "title" .Title
    "permalink" .Permalink
    "content" $content
    "tags" .Params.tags
  -}}
  {{- $index = $index | append $entry -}}
{{- end -}}
{{- $index | jsonify -}}
