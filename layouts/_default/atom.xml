{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ if eq  .Title  .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
  <link href="{{ .Permalink }}" rel="alternate" type="text/html" />
  <link href="{{ .Permalink }}atom.xml" rel="self" type="application/atom+xml" />
  <updated>{{ .Date.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
  <id>{{ .Permalink }}</id>
  {{ with .Site.Params.author }}<author>
    <name>{{ . }}</name>
  </author>{{ end }}
  {{ with .Site.Params.defaultDescription }}<subtitle>{{ . }}</subtitle>{{ end }}
  {{ range first 20 .Data.Pages }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html" />
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
    {{ with .Params.author }}<author>
      <name>{{ . }}</name>
    </author>{{ end }}
    <summary type="html">{{ .Summary | html }}</summary>
    {{ if .Site.Params.atom.fullContent }}
    <content type="html">{{ .Content | html }}</content>
    {{ end }}
  </entry>
  {{ end }}
</feed>
